{
  "name": "inklodge",
  "private": true,
  "version": "0.1.0",
  "description": "Inklodge 墨庐 · 古典武侠与当代叙事的沉浸式阅读空间（AI 写作流程 + 网页阅读）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/consistency-check.mjs",
    "check:strict": "node scripts/consistency-check.mjs --strict",
    "verify": "node scripts/consistency-check.mjs --dedup",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "preview": "vite preview",
    "prebuild": "node scripts/sync.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
