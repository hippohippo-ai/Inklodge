{
  "name": "inklodge",
  "private": true,
  "version": "0.1.0",
  "description": "Inklodge 墨庐 · 古典武侠与当代叙事的沉浸式阅读空间（AI 写作流程 + 网页阅读）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/consistency-check.mjs",
    "check:strict": "node scripts/consistency-check.mjs --strict",
    "verify": "node scripts/consistency-check.mjs --dedup && node scripts/character-cadence.mjs --book 天阙 --max-gap 100 --tail 100 --fail-on-violation",
    "cadence": "node scripts/character-cadence.mjs --book 天阙 --max-gap 100 --tail 100",
    "cadence:save": "node scripts/character-cadence.mjs --book 天阙 --max-gap 100 --tail 100 --save-baseline",
    "cadence:check": "node scripts/character-cadence.mjs --book 天阙 --max-gap 100 --tail 100 --fail-on-violation",
    "style": "node scripts/style-fingerprint.mjs",
    "style:diff": "node scripts/style-fingerprint.mjs --diff --fail-on-drift",
    "style:save": "node scripts/style-fingerprint.mjs --save",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "preview": "vite preview",
    "prebuild": "node scripts/sync.mjs",
    "deploy": "npm run build && gh-pages -d dist",
    "life:board": "node scripts/life-window-board.mjs",
    "life:board:outline": "node scripts/life-board-outline.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
