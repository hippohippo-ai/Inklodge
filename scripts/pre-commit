#!/bin/sh
# 预提交门槛（安装：npm run hooks:install；跳过单次：git commit --no-verify；卸载：删掉本文件）
#
# ① 源／镜像／台账三向一致性 + F23 跨章物件持有链（scripts/consistency-check.mjs --min 0，不含字数）
# ② 本次提交涉及的正文章节跑各书 state/dedup-check.py（含 F22 单章字数下限 4000 的拦截）
#    并置 F24A_STRIP_PUNCT=1：F24a 标点剥离收紧态 —— 已入册章(F24A_TREATED)出现超基线的新重复即拦截
#    （treated 章回归门禁）；未入册章仍只报告、不判失败（存量锁基线，见 state/prose-polish-plan.md §十一）。
# ③ 本次提交涉及的正文章节跑各书 state/summary-camera-scan.py 的 `e --gate`：
#    E1 人称收紧态 —— 已入册章(E1_TREATED)出现超基线的新人称离群即拦截；未入册章只报告
#    （同 F24a 棘轮；见 state/prose-polish-plan.md §十二）。
#    另:改了 state/characters.md 的书跑 `e --gender`——已裁定的性别定向被改／性别翻转即拦截
#    （GENDER_EXPECT 硬断言 + gender-baseline.json 快照；见 §十三）。
#
# 硬门禁失败即中止提交；文风报告无论命中或运行异常均不影响提交。
# node/python 缺失时对应步骤跳过并提示，不会因为环境问题卡住提交。

set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0
fail=0

# ── ① 一致性（静默跑；失败时重跑一次显示细节） ──────────────────
if command -v node >/dev/null 2>&1; then
  if ! node "$ROOT/scripts/consistency-check.mjs" --min 0 --quiet >/dev/null 2>&1; then
    echo "[pre-commit] 一致性检查未通过，详情：" >&2
    node "$ROOT/scripts/consistency-check.mjs" --min 0 >&2 || true
    echo "" >&2
    echo "[pre-commit] 提交已中止。" >&2
    echo "  · 镜像过期：npm run build 重新同步（镜像由 sync.mjs 生成，勿手改）" >&2
    echo "  · 章题不符：先改卷纲 outline-volN.md 或正文章题，再重跑" >&2
    echo "  · 索引漏列：npm run build 后重试" >&2
    echo "  · F23 跨章持有链：改交接/分拆时同步 state/custody-chains.json（锚点与交接词）" >&2
    fail=1
  fi
else
  echo "[pre-commit] 未找到 node，跳过一致性检查" >&2
fi

# ── ② 本次提交的正文章节 → 各书 dedup-check.py（含 F22 字数拦截） ──
PY=""
for c in python python3; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -n "$PY" ]; then
  # -c core.quotePath=false: 否则中文路径会被 git 转义加引号，sed 匹配不上
  staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
  books=$(printf '%s\n' "$staged" \
          | sed -n 's#^\(books/[^/]*\)/novel/chapter-[0-9]*\.md$#\1#p' | sort -u)
  for b in $books; do
    script="$ROOT/$b/state/dedup-check.py"
    [ -f "$script" ] || continue
    nums=$(printf '%s\n' "$staged" \
           | sed -n "s#^$b/novel/chapter-\([0-9]*\)\.md\$#\1#p" | tr '\n' ' ')
    [ -n "$(printf '%s' "$nums" | tr -d ' ')" ] || continue
    if ! F24A_STRIP_PUNCT=1 PYTHONIOENCODING=utf-8 "$PY" "$script" $nums >&2; then
      echo "" >&2
      echo "[pre-commit] dedup-check 未通过（含 F22 单章字数下限 4000 + F24a 收紧态回归门禁），提交已中止：$b" >&2
      echo "  · 低于 4000 字：补一段具体后果动作（勿补抽象议论）后重跑" >&2
      echo "  · F24a·章内重复(标点剥离) ✗ 超过入册基线：已入册章出现了新的跨标点重复——改写该处，" >&2
      echo "    或（确认是有意重复时）改 F24A_TREATED 基线并在 state/prose-polish-plan.md §十一 登记" >&2
      echo "  · 其他规则命中：按上方 × 行修正" >&2
      fail=1
    fi
  done

  # ── ③ 本次提交的正文章节 → E1 人称收紧门禁（treated 章回归；未入册章只报告） ──
  any_e=0
  for b in $books; do
    script="$ROOT/$b/state/summary-camera-scan.py"
    [ -f "$script" ] || continue
    nums=$(printf '%s\n' "$staged" \
           | sed -n "s#^$b/novel/chapter-\([0-9]*\)\.md\$#\1#p" | tr '\n' ' ')
    [ -n "$(printf '%s' "$nums" | tr -d ' ')" ] || continue
    any_e=1
    if ! PYTHONIOENCODING=utf-8 "$PY" "$script" e --gate $nums >&2; then
      echo "" >&2
      echo "[pre-commit] E1 人称收紧门禁未通过，提交已中止：$b" >&2
      echo "  · 已入册章出现超过存量基线的新「人称离群」（某人物被连续写成反向代词）——逐处看主语修正" >&2
      echo "  · 确属正当（反代词指别人）时改 E1_TREATED 基线并在 state/prose-polish-plan.md §十二 登记" >&2
      fail=1
    fi
  done
  [ "$any_e" = 1 ] || echo "[pre-commit] 本次提交未涉及正文章节，跳过 E1 门禁" >&2

  # ③b 改了人物卡（state/characters.md）的书 → 性别口径门禁
  cbooks=$(printf '%s\n' "$staged" \
           | sed -n 's#^\(books/[^/]*\)/state/characters\.md$#\1#p' | sort -u)
  for b in $cbooks; do
    script="$ROOT/$b/state/summary-camera-scan.py"
    [ -f "$script" ] || continue
    if ! PYTHONIOENCODING=utf-8 "$PY" "$script" e --gender >&2; then
      echo "" >&2
      echo "[pre-commit] 性别口径门禁未通过，提交已中止：$b" >&2
      echo "  · 已裁定定向被改动（云裳＝F／守真真人＝M？）或某人物性别相对 gender-baseline.json 翻转" >&2
      echo "  · 若确属有意改动：改 GENDER_EXPECT／正文与卡，并重存基线 e --gender --save，在 §十三 登记" >&2
      fail=1
    fi
  done
else
  echo "[pre-commit] 未找到 python，跳过 dedup-check 与 E1 门禁（字数／F24a／E1 拦截本次未生效）" >&2
fi

# ── ④ 独立文风信号步骤：即使无 Python 或探针异常也不改变提交判定 ──
# 仅打印相对 HEAD 新增候选，不计入 fail、不影响 dedup-check 或提交结果。
if command -v node >/dev/null 2>&1; then
  node "$ROOT/scripts/style-signals-delta.mjs" --staged >&2 || \
    echo "[pre-commit] 文风信号报告异常，已忽略（不影响提交）" >&2
else
  echo "[pre-commit] 未找到 node，跳过 R3/R4/R5 新增信号报告" >&2
fi

exit $fail
